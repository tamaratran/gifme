# Copy to .env and fill in. The Expo app reads EXPO_PUBLIC_* vars at build time.
#
# Firebase web config — find these at:
#   https://console.firebase.google.com/project/<your-project>/settings/general/
# (bottom of the page, under "Your apps")
#
# These values are safe to ship in the client bundle. They identify the
# project; they're not secrets. Server-only secrets (like the Replicate
# token) live in Firebase Secret Manager, set via:
#   firebase functions:secrets:set REPLICATE_API_TOKEN
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
